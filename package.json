{
  "name": "photos-api",
  "version": "1.0.0",
  "description": "Shared photo storage API for kylies.photos and kylieis.online",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "types": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply cb953cd1-3de2-4eb1-9769-b1b1d817b59d --dir migrations --local",
    "db:migrate:remote": "cf d1 migrations apply cb953cd1-3de2-4eb1-9769-b1b1d817b59d --dir migrations",
    "db:seed:local": "wrangler d1 execute photos-db --local --file=scripts/seed-test-data.sql",
    "test": "npx tsx scripts/test-integration.ts",
    "test:local": "API_URL=http://localhost:8787 npx tsx scripts/test-integration.ts",
    "test:metadata": "npx tsx --test src/photo-metadata.test.ts src/location-matcher.test.ts",
    "exif:local:plan": "npx tsx scripts/migrate/plan-local-exif.ts",
    "exif:local:apply": "npx tsx scripts/migrate/apply-local-exif.ts --apply",
    "migrate:flickr": "npx tsx scripts/migrate/from-flickr.ts",
    "migrate:cf-images": "npx tsx scripts/migrate/from-cf-images.ts",
    "migrate:notion": "npx tsx scripts/migrate/from-notion.ts",
    "migrate:climb-links": "npx tsx scripts/migrate/backfill-climb-links.ts",
    "migrate:map-peaks": "npx tsx scripts/migrate/map-centennial-photos.ts",
    "backfill:aliases": "npx tsx scripts/migrate/backfill-photo-aliases.ts",
    "generate:blurhash": "npx tsx scripts/migrate/generate-blurhash.ts",
    "import:local:plan": "npx tsx scripts/migrate/import-local-photos.ts",
    "import:local:apply": "npx tsx scripts/migrate/import-local-photos.ts --apply",
    "test:import-local": "npx tsx --test scripts/migrate/import-local-photos.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^25.9.1",
    "cf": "^1.0.0-beta.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.151.0"
  },
  "optionalDependencies": {
    "blurhash": "^2.0.5",
    "sharp": "^0.33.0"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "hono": "^4.12.22",
    "jose": "^6.2.3"
  }
}
